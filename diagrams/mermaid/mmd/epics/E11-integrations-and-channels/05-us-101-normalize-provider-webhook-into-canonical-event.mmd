flowchart TD
    W["Webhook"] --> V["Verify signature and timestamp window"]
    V -- fail --> R["Reject and SecurityEvent"]
    V -- ok --> D["Dedupe on provider_event_id"]
    D -- seen --> S["200, no reprocess"]
